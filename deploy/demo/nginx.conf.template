limit_req_zone $binary_remote_addr zone=api:10m rate=${GATEWAY_API_RATE};
limit_req_zone $binary_remote_addr zone=auth:10m rate=${GATEWAY_AUTH_RATE};
map "$request_method:$uri" $expensive_key {
    default "";
    ~^POST: $binary_remote_addr;
    ~^GET:/api/backend/organizations/[^/]+/operations/export $binary_remote_addr;
}
limit_req_zone $expensive_key zone=expensive:10m rate=${GATEWAY_EXPENSIVE_RATE};
limit_req_status 429;
# Never log URLs, query strings, cookies, bodies, or upstream exception text.
log_format safe escape=json '{"request_id":"$request_id","status":$status,"duration":$request_time}';
access_log /var/log/nginx/access.log safe;
error_log /var/log/nginx/error.log crit;
server { listen 80; server_name ${APP_DOMAIN}; return 308 ${PUBLIC_ORIGIN}$request_uri; }
server {
    listen 443 ssl;
    server_name ${APP_DOMAIN};
    if ($host != "${APP_DOMAIN}") { return 421; }
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size ${GATEWAY_MAX_BODY};
    client_body_timeout 30s;
    send_timeout 120s;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'" always;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Request-ID $request_id;
    proxy_read_timeout 125s;
    proxy_connect_timeout 5s;
    location ~ ^/api/backend/(auth/(login|register|refresh)|demo/enter)$ {
        limit_req zone=auth burst=10 nodelay;
        proxy_pass http://frontend:3000;
    }
    location ~ ^/api/backend/organizations/[^/]+/(intelligence/(search|conversations/[^/]+/messages)|structured/runs|operations/export) {
        limit_req zone=expensive burst=10 nodelay;
        limit_req zone=api burst=40 nodelay;
        proxy_pass http://frontend:3000;
    }
    location /api/backend/ {
        limit_req zone=api burst=40 nodelay;
        proxy_pass http://frontend:3000;
    }
    location /api/v1/ { return 404; }
    location / { proxy_pass http://frontend:3000; }
}
