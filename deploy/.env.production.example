# Copy to deploy/.env.production (ignored). No credentials belong in this file.
APP_DOMAIN=localhost
PUBLIC_ORIGIN=https://localhost:8443
HTTP_PORT=8080
HTTPS_PORT=8443
# Public deployments normally use HTTP_PORT=80 and HTTPS_PORT=443.
UPLOAD_MAX_BYTES=20971520
GATEWAY_MAX_BODY=21m
GATEWAY_API_RATE=20r/s
GATEWAY_AUTH_RATE=10r/m
GATEWAY_EXPENSIVE_RATE=30r/m
EMBEDDINGS_ENABLED=false
OCR_ENABLED=false
OCR_LANGUAGE=eng
API_MEMORY=2g
WORKER_MEMORY=3g
API_CPUS=2
WORKER_CPUS=2
WORKER_STOP_GRACE=11m
