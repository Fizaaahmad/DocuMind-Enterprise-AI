APP_NAME=DocuMind API
ENVIRONMENT=development
# Match the root .env credentials; URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://documind:replace-with-a-local-password@localhost:5432/documind
CORS_ORIGINS=["http://localhost:3000"]
# Generate a random secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required for authentication. Never commit a real value.
AUTH_SECRET=
COOKIE_SECURE=false
ACCESS_TOKEN_MINUTES=10
SESSION_DAYS=7
# Production: ENVIRONMENT=production, COOKIE_SECURE=true, HTTPS CORS_ORIGINS.

# Relative paths resolve against backend/, consistently for API and worker.
STORAGE_PATH=var/documents
UPLOAD_MAX_BYTES=20971520
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
EXTRACTION_MAX_CHARACTERS=2000000
EXTRACTION_MAX_PAGES=1000
DOCX_MAX_UNCOMPRESSED_BYTES=41943040
PROCESSING_MAX_CHUNKS=10000
PROCESSING_TIMEOUT_SECONDS=60
WORKER_POLL_SECONDS=2
WORKER_MAX_ATTEMPTS=3
