APP_NAME=DocuMind API
ENVIRONMENT=development
# Match the root .env credentials; URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://documind:replace-with-a-local-password@localhost:5432/documind
CORS_ORIGINS=["http://localhost:3000"]
# Generate a random secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required for authentication. Never commit a real value.
AUTH_SECRET=
COOKIE_SECURE=false
ACCESS_TOKEN_MINUTES=10
SESSION_DAYS=7
# Production: ENVIRONMENT=production, COOKIE_SECURE=true, HTTPS CORS_ORIGINS.

# Relative paths resolve against backend/, consistently for API and worker.
STORAGE_PATH=var/documents
UPLOAD_MAX_BYTES=20971520
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
EXTRACTION_MAX_CHARACTERS=2000000
EXTRACTION_MAX_PAGES=1000
DOCX_MAX_UNCOMPRESSED_BYTES=41943040
PROCESSING_MAX_CHUNKS=10000
PROCESSING_TIMEOUT_SECONDS=60
WORKER_POLL_SECONDS=2
WORKER_MAX_ATTEMPTS=3

# Optional PDF OCR. Leave disabled until the external Tesseract installation works.
OCR_ENABLED=false
TESSERACT_CMD=tesseract
# Optional directory containing eng.traineddata (empty uses Tesseract defaults).
OCR_TESSDATA_DIR=
OCR_LANGUAGE=eng
OCR_DPI=200
OCR_MIN_TEXT_CHARACTERS=20
OCR_MAX_PAGES=20
OCR_MAX_PIXELS=12000000
OCR_PAGE_TIMEOUT_SECONDS=30
OCR_DOCUMENT_TIMEOUT_SECONDS=180
OCR_MEMORY_LIMIT_MB=512

# Phase 4: local embeddings. Explicitly prepare the cached model before enabling.
EMBEDDINGS_ENABLED=false
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
EMBEDDING_DIMENSION=384
EMBEDDING_CACHE_PATH=var/models
EMBEDDING_BATCH_SIZE=16
EMBEDDING_THREADS=2
INDEXING_TIMEOUT_SECONDS=600
RETRIEVAL_LIMIT=6
RETRIEVAL_MIN_SIMILARITY=0.3
RAG_CONTEXT_CHARACTERS=12000
# Only disabled and mock are currently supported. Mock is development-only.
LLM_PROVIDER=disabled
LLM_MODEL=extractive-mock-v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0
AI_DAILY_REQUESTS=100

# Phase 5: full-revision deterministic analysis. Embeddings are not required.
ANALYSIS_MAX_CHARACTERS=500000
ANALYSIS_TIMEOUT_SECONDS=120
ANALYSIS_MAX_ITEMS=500
